    "title": "Mushroom Risotto",
    "description": "A slow-stirred, savory risotto for a relaxed evening.",
    "servings": 2,
    "dietary_attributes": {
      "is_vegetarian": true
    },
    "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/e/ed/Mushroom_and_Leek_Risotto_%2849535206656%29.jpg/960px-Mushroom_and_Leek_Risotto_%2849535206656%29.jpg",
    "ingredients": [
      {

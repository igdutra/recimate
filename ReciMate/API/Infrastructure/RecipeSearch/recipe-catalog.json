        "name": "Arborio rice",
        "quantity": "300 g"
      },
      {
        "id": "mushrooms",
        "name": "Mushrooms",
        "quantity": "250 g"
      },
      {
        "id": "vegetable-stock",
        "name": "Vegetable stock",
        "quantity": "1 l"
      },
      {
        "id": "parmesan",
        "name": "Parmesan",
        "quantity": "50 g"
      },
      {
        "id": "cream",
        "name": "Single cream",
        "quantity": "100 ml"
      }
    ],
    "cooking_instructions": [
      {
        "step": 1,
        "text": "Warm the stock in a saucepan and keep it at a low simmer."
      },
      {
        "step": 2,
        "text": "Sauté the sliced mushrooms until golden, then set them aside."
      },
      {
